from fastapi import FastAPI, HTTPException

from typing import List


app = FastAPI(title="Multi-User Task Management API")


# -----------------------------
# Data Models
# -----------------------------

class User():
    id: int
    name: str
    email: str


class Task():
    id: int
    title: str
    description: str
    completed: bool = False
    user_id: int


class TaskCreate():
    title: str
    description: str
    user_id: int


# -----------------------------
# Temporary Database
# -----------------------------

users = [
    User(id=1, name="Rahul", email="rahul@gmail.com"),
    User(id=2, name="Kiran", email="kiran@gmail.com"),
    User(id=3, name="Anil", email="anil@gmail.com")
]

tasks = [
    Task(
        id=1,
        title="Learn Python",
        description="Practice Python basics",
        completed=False,
        user_id=1
    ),
    Task(
        id=2,
        title="Learn FastAPI",
        description="Create REST APIs",
        completed=False,
        user_id=2
    )
]


# -----------------------------
# Home
# -----------------------------

@app.get("/")
def home():
    return {
        "message": "Multi-User Task Management API is running"
    }


# -----------------------------
# User APIs
# -----------------------------

@app.get("/users")
def get_users():
    return users


@app.get("/users/{user_id}")
def get_user(user_id: int):

    for user in users:
        if user.id == user_id:
            return user

    raise HTTPException(
        status_code=404,
        detail="User not found"
    )


# -----------------------------
# Create User
# -----------------------------

@app.post("/users")
def create_user(user: User):

    for existing_user in users:
        if existing_user.id == user.id:
            raise HTTPException(
                status_code=400,
                detail="User ID already exists"
            )

    users.append(user)

    return {
        "message": "User created successfully",
        "user": user
    }


# -----------------------------
# Task APIs
# -----------------------------

@app.get("/tasks")
def get_all_tasks():
    return tasks


# -----------------------------
# Get Tasks of One User
# -----------------------------

@app.get("/users/{user_id}/tasks")
def get_user_tasks(user_id: int):

    # Check user
    user_exists = False

    for user in users:
        if user.id == user_id:
            user_exists = True
            break

    if not user_exists:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    user_tasks = []

    for task in tasks:
        if task.user_id == user_id:
            user_tasks.append(task)

    return user_tasks


# -----------------------------
# Create Task
# -----------------------------

@app.post("/tasks")
def create_task(task_data: TaskCreate):

    # Check user
    user_exists = False

    for user in users:
        if user.id == task_data.user_id:
            user_exists = True
            break

    if not user_exists:
        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    new_id = len(tasks) + 1

    new_task = Task(
        id=new_id,
        title=task_data.title,
        description=task_data.description,
        completed=False,
        user_id=task_data.user_id
    )

    tasks.append(new_task)

    return {
        "message": "Task created successfully",
        "task": new_task
    }


# -----------------------------
# Get One Task
# -----------------------------

@app.get("/tasks/{task_id}")
def get_task(task_id: int):

    for task in tasks:
        if task.id == task_id:
            return task

    raise HTTPException(
        status_code=404,
        detail="Task not found"
    )


# -----------------------------
# Update Task
# -----------------------------

@app.put("/tasks/{task_id}")
def update_task(task_id: int, task_data: TaskCreate):

    for i, task in enumerate(tasks):

        if task.id == task_id:

            # Check user
            user_exists = False

            for user in users:
                if user.id == task_data.user_id:
                    user_exists = True
                    break

            if not user_exists:
                raise HTTPException(
                    status_code=404,
                    detail="User not found"
                )

            updated_task = Task(
                id=task.id,
                title=task_data.title,
                description=task_data.description,
                completed=task.completed,
                user_id=task_data.user_id
            )

            tasks[i] = updated_task

            return {
                "message": "Task updated successfully",
                "task": updated_task
            }

    raise HTTPException(
        status_code=404,
        detail="Task not found"
    )


# -----------------------------
# Complete Task
# -----------------------------

@app.patch("/tasks/{task_id}/complete")
def complete_task(task_id: int):

    for i, task in enumerate(tasks):

        if task.id == task_id:

            updated_task = Task(
                id=task.id,
                title=task.title,
                description=task.description,
                completed=True,
                user_id=task.user_id
            )

            tasks[i] = updated_task

            return {
                "message": "Task completed successfully",
                "task": updated_task
            }

    raise HTTPException(
        status_code=404,
        detail="Task not found"
    )


# -----------------------------
# Delete Task
# -----------------------------

@app.delete("/tasks/{task_id}")
def delete_task(task_id: int):

    for i, task in enumerate(tasks):

        if task.id == task_id:

            deleted_task = tasks.pop(i)

            return {
                "message": "Task deleted successfully",
                "task": deleted_task
            }

    raise HTTPException(
        status_code=404,
        detail="Task not found"
    )

